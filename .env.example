POSTGRES_PASSWORD=replace-with-a-long-random-password
DISCORD_BOT_TOKEN=
DISCORD_NEW_BOT_TOKEN=
# Select legacy, new, or testing when running more than one instance.
FISHIE_BOT_INSTANCE=legacy
# The replacement instance owns the API while both bots are online.
FISHIE_API_ENABLED=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FISHIE_CREDENTIAL_KEY=
# Comma-separated reverse-proxy IPs allowed to supply X-Forwarded-For.
FISHIE_TRUSTED_PROXIES=127.0.0.1,::1
